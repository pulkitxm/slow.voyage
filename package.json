{
  "name": "slowroads.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite --host 0.0.0.0 --port 3002 --strictPort",
    "build": "bun run --bun vite build && bun scripts/seo.ts && bun scripts/offline.ts",
    "preview": "bun run --bun vite preview --host 0.0.0.0 --port 3002 --strictPort",
    "check": "bun run --bun tsr generate && bun run --bun tsc --noEmit && bun run --bun tsc --project tsconfig.worker.json",
    "lint": "biome check .",
    "format": "biome check --write . && prettier --write lefthook.yml",
    "yaml": "bun scripts/yaml.ts && prettier --check lefthook.yml",
    "test": "bun test src/game src/seo.test.ts",
    "validate": "bun run lint && bun run yaml && bun run check && bun run test",
    "prepare": "lefthook install",
    "test:offline": "bun test tests/offline.test.ts",
    "test:browser": "bun test tests/browser.test.ts",
    "review:capture": "bun scripts/review.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tanstack/router-cli": "^1.167.46",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.2"
}
